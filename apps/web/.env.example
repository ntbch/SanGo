# ------------------------------------------------------------------
# SanGo Web — Biến môi trường mẫu (Vite)
# Sao chép thành .env hoặc .env.local trước khi chạy
# ------------------------------------------------------------------

# Base URL của Backend REST API (mặc định: /api/v1 qua Vite proxy tới http://localhost:4000)
VITE_API_URL=/api/v1

# Bật chế độ Mock API in-memory (true/false, mặc định: false)
VITE_USE_MOCK=false
