# ------------------------------------------------------------------
# CourtHub API — Biến môi trường mẫu
# Sao chép thành .env trước khi chạy (không commit file .env thật)
# ------------------------------------------------------------------

# Cổng lắng nghe của API NestJS (mặc định: 4000)
PORT=4000

# Chuỗi kết nối PostgreSQL (Docker dev hoặc Neon/Postgres thật)
DATABASE_URL="postgresql://courthub:courthub@localhost:5432/courthub?schema=public"

# Secret khóa ký JWT access & refresh token (sinh bằng: openssl rand -hex 32)
JWT_SECRET="dev-only-access-secret-do-not-use-in-prod"
JWT_REFRESH_SECRET="dev-only-refresh-secret-do-not-use-in-prod"

# Cờ Secure cho cookie refresh token (mặc định true; đặt 'false' nếu demo qua HTTP không phải localhost)
COOKIE_SECURE=true

# Chế độ thanh toán: 'mock' (giả lập demo offline) hoặc 'vnpay' (sandbox VNPay)
PAYMENT_MODE=mock

# URL Frontend để redirect sau khi hoàn tất thanh toán
FRONTEND_URL=http://localhost:5173

# Cấu hình VNPay Sandbox (chỉ bắt buộc khi PAYMENT_MODE=vnpay)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_SANDBOX_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/v1/payments/vnpay/callback

# Khóa Google Gemini cho Trợ lý AI giai đoạn 2 (chưa bắt buộc — bản rule-based đang dùng)
GEMINI_API_KEY=
