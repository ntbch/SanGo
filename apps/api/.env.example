# ------------------------------------------------------------------
# CourtHub API — Biến môi trường mẫu
# Sao chép thành .env trước khi chạy (không commit file .env thật)
# ------------------------------------------------------------------

# Cổng lắng nghe của API NestJS (mặc định: 4000)
PORT=4000

# Chuỗi kết nối PostgreSQL (Docker dev hoặc Neon/Postgres thật)
DATABASE_URL="postgresql://sango:sango@localhost:5432/sango?schema=public"

# Secret khóa ký JWT access & refresh token (sinh bằng: openssl rand -hex 32)
JWT_SECRET="dev-only-access-secret-do-not-use-in-prod"
JWT_REFRESH_SECRET="dev-only-refresh-secret-do-not-use-in-prod"

# Cờ Secure cho cookie refresh token (mặc định true; đặt 'false' nếu demo qua HTTP không phải localhost)
COOKIE_SECURE=true

# Chế độ thanh toán: 'mock' (giả lập demo offline) hoặc 'vnpay' (sandbox VNPay)
PAYMENT_MODE=mock

# URL Frontend để redirect sau khi hoàn tất thanh toán
FRONTEND_URL=http://localhost:5173

# URL public của chính API, dùng để dựng avatarUrl (không lấy từ Host header).
# BẮT BUỘC cho tính năng tải ảnh đại diện — thiếu thì endpoint trả 503.
PUBLIC_API_URL=http://localhost:4000/api/v1

# Nơi lưu file avatar. Để trống sẽ dùng uploads/avatars tương đối so với cwd
# (file sẽ mất sau mỗi lần deploy) — production nên trỏ ra nơi lưu lâu dài.
AVATAR_UPLOAD_DIR=uploads/avatars

# Cấu hình VNPay Sandbox (chỉ bắt buộc khi PAYMENT_MODE=vnpay)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_SANDBOX_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/v1/payments/vnpay/callback

# P3 — Hoàn tiền về thẻ qua API VNPay DR (refund): mặc định OFF. Khi OFF hoặc
# refund fail -> fallback hoàn ví nội bộ như hiện tại, không ảnh hưởng luồng nào.
# Chỉ bật khi có merchant thật (sandbox VNPAY giới hạn refund — cần liên hệ VNPAY).
VNPAY_REFUND_ENABLED=false
# Tài khoản portal merchant VNPay khi bật refund thật (placeholder — chưa dùng trong payload DR).
VNPAY_API_USER=
VNPAY_API_PASSWORD=

# ------------------------------------------------------------------
# Trợ lý AI Agent (2026-08-26): LLM_PROVIDER=none -> rule-based (mặc định, offline ok)
# LLM_PROVIDER=gemini + GEMINI_API_KEY -> agent tool-use đa lượt qua Gemini REST.
# Free tier gemini-2.5-flash: 1500 req/ngày, không cần thẻ.
# ------------------------------------------------------------------
LLM_PROVIDER=none
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Ngân sách thời gian TỔNG mỗi request agent (ms) — quá hạn rơi về rule-based
# AI_AGENT_DEADLINE_MS=10000

# ------------------------------------------------------------------
# Email (GĐ2): để trống SMTP_HOST -> mail ghi log console ([MAIL] to=... subject=...)
# Cấu hình đủ SMTP_* + cài nodemailer thì SmtpMailer mới gửi thật.
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SanGo <no-reply@sango.vn>"
