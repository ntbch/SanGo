# ------------------------------------------------------------------
# CourtHub API — biến môi trường mẫu. Copy thành .env (không commit .env).
# ------------------------------------------------------------------

# Postgres dev: docker compose lên DB của T1 (pnpm db:up)
DATABASE_URL="postgresql://courthub:courthub@localhost:5432/courthub?schema=public"

# Secrets cho JWT — sinh giá trị thật bằng: openssl rand -hex 32
JWT_SECRET="change-me-access-token-secret"
JWT_REFRESH_SECRET="change-me-refresh-token-secret"

# PAYMENT_MODE=mock | vnpay — mock để demo khi sandbox VNPay gặp sự cố (đặc tả §3.5)
PAYMENT_MODE=mock

# Cổng API NestJS
PORT=4000
