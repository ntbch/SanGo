// CourtHub — Mô hình dữ liệu Prisma (đặc tả thiết kế §5)
// Quy ước:
// - ID: UUID.
// - Tiền: số nguyên VND.
// - Thời gian chơi: cột 'date' kiểu DATE (đại diện ngày chơi theo giờ VN UTC+7),
//   kèm startMinute/endMinute = phút tính từ 00:00 giờ Việt Nam -> không lỗi múi giờ.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums
// Giá trị enum trùng khớp 1:1 với package '@courthub/shared'.

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum VenueStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SportType {
  FOOTBALL5
  FOOTBALL7
  PICKLEBALL
  BADMINTON
  TENNIS
}

enum CourtStatus {
  ACTIVE
  MAINTENANCE
}

enum DayType {
  WEEKDAY
  WEEKEND
}

enum BookingHoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentType {
  DEPOSIT
  FULL
  REFUND
  /// F4 dịch vụ đi kèm: thanh toán addon SAU khi booking CONFIRMED (mở rộng whitelist parseTxnRef).
  ADD_ON
}

enum PaymentMethod {
  VNPAY
  MOCK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Chiều biến động ví (T0): CREDIT cộng tiền vào ví, DEBIT trừ tiền khỏi ví.
enum WalletLedgerDirection {
  CREDIT
  DEBIT
}

/// Loại biến động ví (T0): TOPUP nạp tiền, PAYMENT trả đơn, REFUND hoàn vào ví, CASHBACK dự phòng v2.
enum WalletLedgerType {
  TOPUP
  PAYMENT
  REFUND
  CASHBACK
}

/// Loại thông báo in-app/email (GĐ2): giá trị trùng khớp @courthub/shared.
enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  NEW_BOOKING_OWNER
  MATCH_JOINED
  MATCH_LEFT
  REMINDER
  // F8 wave-1 (roadmap v5) — additive, không đổi giá trị cũ.
  WALLET
  VOUCHER
  SERVICE
  TEAM
  TOURNAMENT
}

// ---------------------------------------------------------------- models

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
  venues        Venue[]
  bookings      Booking[]      @relation("BookingCustomer")
  bookingHolds  BookingHold[]
  reviews       Review[]
  matchParticipants MatchParticipant[]
  passwordResetTokens PasswordResetToken[]
  notifications     Notification[]
  walletLedgers     WalletLedger[]
  walletTopups      WalletTopup[]
  walletBalance     WalletBalance?
  vouchers          Voucher[]          @relation("VoucherOwner")
  voucherRedemptions VoucherRedemption[]

  @@map("users")
}

/// Refresh token xoay vòng — chỉ lưu tokenHash, không lưu token gốc.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Reset token quên mật khẩu — chỉ lưu sha256(token), token gốc chỉ đi qua email/console dev.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Venue {
  id             String      @id @default(uuid()) @db.Uuid
  ownerId        String      @db.Uuid
  name           String
  slug           String      @unique
  address        String
  city           String      @default("Hà Nội")
  district       String      @default("Cầu Giấy")
  lat            Float
  lng            Float
  openMinute     Int
  closeMinute    Int
  images         String[]
  amenities      String[]
  depositPercent Int         @default(30)
  status         VenueStatus @default(PENDING)
  rejectReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id])
  courts  Court[]
  reviews Review[]

  @@index([status])
  @@index([city, district])
  @@map("venues")
}

model Court {
  id                  String      @id @default(uuid()) @db.Uuid
  venueId             String      @db.Uuid
  name                String
  sportType           SportType
  /// Độ dài slot: chỉ nhận 60 hoặc 90 (validate ở tầng app/zod).
  slotMinutes         Int
  defaultPricePerSlot Int
  status              CourtStatus @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  venue        Venue         @relation(fields: [venueId], references: [id])
  pricingRules PricingRule[]
  bookings     Booking[]
  holds        BookingHold[]

  @@index([venueId])
  @@map("courts")
}

/// Quy tắc giá ghi đè theo khung giờ x loại ngày; trùng đúng khung giờ sẽ bị chặn UNIQUE.
model PricingRule {
  id           String   @id @default(uuid()) @db.Uuid
  courtId      String   @db.Uuid
  dayType      DayType
  startMinute  Int
  endMinute    Int
  pricePerSlot Int
  createdAt    DateTime @default(now())

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, dayType, startMinute, endMinute])
  @@index([courtId])
  @@map("pricing_rules")
}

/// Giữ chỗ tạm 10 phút khi khách bước vào thanh toán; cron mỗi phút chuyển ACTIVE quá hạn -> EXPIRED.
model BookingHold {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  courtId     String            @db.Uuid
  date        DateTime          @db.Date
  startMinute Int
  endMinute   Int
  subtotal    Int
  /// F3 Voucher: snapshot giảm giá NGAY LÚC ÁP MÃ (callback recompute rồi so vnp_Amount,
  /// nên phải đọc giá đã chốt từ hold). null = chưa áp voucher.
  discountAmount Int?
  finalAmount    Int?
  expiresAt   DateTime
  status      BookingHoldStatus @default(ACTIVE)
  /// Ghép trận mở (GĐ2): giữ lựa chọn công khai từ lúc hold để copy sang Booking.
  isPublicMatch Boolean?
  slotsNeeded   Int?
  createdAt   DateTime          @default(now())

  user  User  @relation(fields: [userId], references: [id])
  court Court @relation(fields: [courtId], references: [id])

  @@index([courtId, date, status])
  @@index([status, expiresAt])
  @@map("booking_holds")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  /// Mã đơn CH-YYYYMMDD-NNNN, sinh ở tầng app.
  code          String        @unique
  customerId    String        @db.Uuid
  courtId       String        @db.Uuid
  date          DateTime      @db.Date
  startMinute   Int
  endMinute     Int
  subtotal      Int
  depositAmount Int
  status        BookingStatus @default(CONFIRMED)
  cancelledAt   DateTime?
  cancelReason  String?
  /// Ghép trận mở (GĐ2): chủ đơn công khai "cần ghép slotsNeeded người".
  isPublicMatch Boolean?
  slotsNeeded   Int?
  matchFull     Boolean?
  /// P2-B2: mốc chống gửi trùng nhắc lịch (null = chưa nhắc ở mốc đó).
  remindedAt24h DateTime?
  remindedAt2h  DateTime?
  /// F2 Ranking: mốc check-in thực tế (null = chưa check-in; dữ liệu cũ NULL tính trung tính).
  checkedInAt DateTime?
  /// F1 Team Profile: đặt sân tư cách đội (FK -> teams sẽ thêm trong migration của F1).
  teamId      String?   @db.Uuid
  createdAt     DateTime      @default(now())

  customer User      @relation("BookingCustomer", fields: [customerId], references: [id])
  court    Court     @relation(fields: [courtId], references: [id])
  payments     Payment[]
  review       Review?
  participants MatchParticipant[]

  @@index([courtId, date])
  @@index([customerId, date])
  @@map("bookings")
}

/// Ghép trận mở (GĐ2 §3.11): người tham gia đơn ghép trận của chủ đơn.
/// UNIQUE(bookingId, userId) chặn join trùng cả ở mức DB (an toàn với race).
model MatchParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  userId    String   @db.Uuid
  joinedAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
  @@index([bookingId])
  @@map("match_participants")
}

/// Bộ đếm cấp phát mã đơn CH-YYYYMMDD-NNNN theo ngày (hotfix 25P02):
/// INSERT ... ON CONFLICT ("date") DO UPDATE ... RETURNING cấp số ATOMIC
/// ngay trong tx của confirmFromHold -> không bao giờ đụng độ UNIQUE(code).
model BookingCodeSeq {
  date    DateTime @id @db.Date
  lastSeq Int      @default(0)

  @@map("booking_code_seq")
}

/// txnRef UNIQUE = idempotency key cho callback cổng thanh toán.
model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @db.Uuid
  amount    Int
  type      PaymentType
  method    PaymentMethod
  txnRef    String        @unique
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  rawPayload Json?
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("payments")
}

/// Sổ cái ví nội bộ (T0) — NGUỒN SỰ THẬT số dư, append-only: không UPDATE/DELETE,
/// ghi SAU khi commit giao dịch chính (tránh kéo dài FOR UPDATE lock).
/// UNIQUE(refType, refId, type) chặn ghi trùng khi callback retry/crash (hoàn kép).
/// Payment(REFUND) chỉ là chứng từ đối soát; dashboard doanh thu đọc từ bảng này.
model WalletLedger {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @db.Uuid
  direction    WalletLedgerDirection
  type         WalletLedgerType
  /// Số tiền biến động (đồng, luôn dương; chiều do direction quyết định).
  amount       Int
  /// refType: 'TOPUP' | 'BOOKING' ... ; refId: id đối tượng gốc (topup txnRef / bookingId).
  refType      String
  refId        String
  /// Số dư ngay sau biến động (denormalized phục vụ hiển thị lịch sử).
  balanceAfter Int
  createdAt    DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([refType, refId, type])
  @@index([userId, createdAt])
  @@map("wallet_ledgers")
}

/// F3 Voucher — mã giảm giá PERCENT, chỉ áp cho hold nằm trọn cửa sổ giờ thấp điểm.
model Voucher {
  id              String    @id @default(uuid()) @db.Uuid
  /// Mã nhập tại checkout — UNIQUE để tra cứu chính xác một mã.
  code            String    @unique
  percentOff      Int
  /// Cửa sổ khung giờ thấp điểm: [startMinute, endMinute) của hold phải nằm trong khoảng này.
  validFromMinute Int
  validToMinute   Int
  /// Tổng số lần được dùng; vượt limit chặn bằng UPDATE ... WHERE usedCount < usageLimit (atomic).
  usageLimit      Int
  /// Tối đa mỗi user (v1: UNIQUE(voucherId, userId) siết về 1 — cột giữ cho v2 mở rộng).
  perUserLimit    Int       @default(1)
  usedCount       Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  /// Owner tạo và quản lý voucher cho venue của mình; áp mã phải khớp venue owner.
  ownerId String @db.Uuid
  owner   User   @relation("VoucherOwner", fields: [ownerId], references: [id])

  redemptions VoucherRedemption[]

  @@index([ownerId])
  @@map("vouchers")
}

/// Lần dùng voucher của từng user — UNIQUE(voucherId, userId) chặn dùng lại khi retry/đồng thời.
model VoucherRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  voucherId String   @db.Uuid
  userId    String   @db.Uuid
  /// Hold đã tiêu mã (audit); không FK vì hold có thể bị cron dọn dẹp.
  holdId   String? @db.Uuid
  /// Số tiền được giảm đã snapshot vào hold lúc áp mã.
  amountDiscounted Int
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([voucherId, userId])
  @@index([userId])
  @@map("voucher_redemptions")
}

/// Yêu cầu nạp tiền qua mock gateway (F6). KHÔNG dùng bảng Payment vì Payment.bookingId
/// NOT NULL (topup không gắn booking) — txnRef UNIQUE đóng vai trò idempotency key,
/// callback đối chiếu amount với bản ghi này trước khi ghi ledger.
model WalletTopup {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  /// Số tiền yêu cầu nạp (đồng) — callback phải khớp đúng.
  amount    Int
  method    PaymentMethod @default(MOCK)
  /// Giữ nguyên shape "<id>.TOPUP.<rand>" như Payment.txnRef (riêng namespace TOPUP).
  txnRef    String        @unique
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  rawPayload Json?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("wallet_topups")
}

/// Hàng dư ví mỗi user (F6): cache đồng bộ trong CÙNG transaction với ledger,
/// khoá FOR UPDATE để tính balanceAfter và chặn trừ âm; nguồn sự thật vẫn là wallet_ledgers
/// (lệch số có thể dựng lại bằng SUM ledger theo direction).
model WalletBalance {
  userId    String   @id @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("wallet_balances")
}

/// Mỗi đơn chỉ được đánh giá một lần (bookingId UNIQUE); người đánh giá là khách trong đơn COMPLETED.
model Review {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @db.Uuid
  venueId    String   @db.Uuid
  customerId String   @db.Uuid
  /// 1..5 — validate range ở tầng app (zod).
  rating     Int
  comment    String
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  venue    Venue   @relation(fields: [venueId], references: [id])
  customer User    @relation(fields: [customerId], references: [id])

  @@index([venueId])
  @@map("reviews")
}

/// Thông báo in-app của một người dùng (GĐ2): tạo nội bộ từ các luồng
/// đặt sân/thanh toán/ghép trận; đọc qua GET /notifications.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Đường dẫn phía web (vd /bookings/CH-...) để điều hướng sau khi bấm.
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}