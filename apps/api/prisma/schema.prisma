// SanGo — Mô hình dữ liệu Prisma (đặc tả thiết kế §5)
// Quy ước:
// - ID: UUID.
// - Tiền: số nguyên VND.
// - Thời gian chơi: cột 'date' kiểu DATE (đại diện ngày chơi theo giờ VN UTC+7),
//   kèm startMinute/endMinute = phút tính từ 00:00 giờ Việt Nam -> không lỗi múi giờ.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums
// Giá trị enum trùng khớp 1:1 với package '@courthub/shared'.

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum VenueStatus {
  PENDING
  APPROVED
  REJECTED
  /// Treo bởi ADMIN: ẩn khỏi tìm kiếm public, không đặt được.
  SUSPENDED
}

enum SportType {
  FOOTBALL5
  FOOTBALL7
  PICKLEBALL
  BADMINTON
  TENNIS
}

enum CourtStatus {
  ACTIVE
  MAINTENANCE
}

enum DayType {
  WEEKDAY
  WEEKEND
}

enum BookingHoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentType {
  DEPOSIT
  FULL
  REFUND
  /// F4 dịch vụ đi kèm: thanh toán addon SAU khi booking CONFIRMED (mở rộng whitelist parseTxnRef).
  ADD_ON
}

enum PaymentMethod {
  VNPAY
  MOCK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Chiều biến động ví (T0): CREDIT cộng tiền vào ví, DEBIT trừ tiền khỏi ví.
enum WalletLedgerDirection {
  CREDIT
  DEBIT
}

/// Loại biến động ví (T0): TOPUP nạp tiền, PAYMENT trả đơn, REFUND hoàn vào ví, CASHBACK dự phòng v2.
enum WalletLedgerType {
  TOPUP
  PAYMENT
  REFUND
  CASHBACK
}

/// Loại thông báo in-app/email (GĐ2): giá trị trùng khớp @courthub/shared.
enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  NEW_BOOKING_OWNER
  MATCH_JOINED
  MATCH_LEFT
  REMINDER
  // F8 wave-1 (roadmap v5) — additive, không đổi giá trị cũ.
  WALLET
  VOUCHER
  SERVICE
  TEAM
  TOURNAMENT
  MATCH_REQUEST
  FUND_DRIVE
}

/// Vai trò thành viên đội (S2-F1): CAPTAIN tạo/quản lý đội, MEMBER tham gia.
enum TeamMemberRole {
  CAPTAIN
  MEMBER
}

/// Trạng thái thành viên đội (S2-F1): PENDING khi vừa nhận link mời, ACTIVE sau khi chấp nhận.
enum TeamMemberStatus {
  ACTIVE
  PENDING
}

/// Cấp độ trận / tự đánh giá trình độ (P6, P7)
enum MatchLevel {
  FRIENDLY
  CASUAL
  SCRIM
  SEMI_PRO
}

/// Chân thuận (P7)
enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}

/// Trạng thái yêu cầu tham gia kèo (P6)
enum MatchJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Phạm vi đợt thu quỹ (P5)
enum FundDriveScope {
  MONTHLY
  MATCH
}

/// Trạng thái đợt thu quỹ (P5)
enum FundDriveStatus {
  ACTIVE
  CLOSED
}

/// Loại giao dịch quỹ đội (P5)
enum TeamFundEntryType {
  INCOME
  EXPENSE
}

/// Trạng thái khoản chia tiền đội (S2-F1, TRACK-ONLY — không liên quan WalletLedger cá nhân).
enum ExpenseShareStatus {
  UNPAID
  PAID
}

/// Loại dịch vụ đi kèm (S2-F4).
enum VenueServiceType {
  BEVERAGE
  EQUIPMENT
  OTHER
}

// ---------------------------------------------------------------- models

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  bannerUrl    String?
  bio          String?
  favoriteSports SportType[]
  preferredPositions String[]
  preferredFoot PreferredFoot?
  selfLevel    MatchLevel?
  bankName     String?
  bankAccountNumber String?
  bankAccountName String?
  notifyEmail  Boolean    @default(true)
  notifyInApp  Boolean    @default(true)
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
  venues        Venue[]
  bookings      Booking[]      @relation("BookingCustomer")
  bookingHolds  BookingHold[]
  reviews       Review[]
  matchParticipants MatchParticipant[]
  passwordResetTokens PasswordResetToken[]
  notifications     Notification[]
  walletLedgers     WalletLedger[]
  walletTopups      WalletTopup[]
  walletBalance     WalletBalance?
  vouchers          Voucher[]          @relation("VoucherOwner")
  voucherRedemptions VoucherRedemption[]
  teamsCaptained    Team[]             @relation("TeamCaptain")
  teamMemberships   TeamMember[]
  expenseSharesPaid ExpenseShare[]     @relation("ExpenseSharePayer")
  expenseSharesOwed ExpenseShare[]     @relation("ExpenseShareDebtor")
  tournamentsCreated Tournament[]
  matchJoinRequests  MatchJoinRequest[]
  matchComments      MatchComment[]
  fundContributions  FundContribution[]
  teamExpensesLogged TeamExpense[]

  @@map("users")
}

/// Refresh token xoay vòng — chỉ lưu tokenHash, không lưu token gốc.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Reset token quên mật khẩu — chỉ lưu sha256(token), token gốc chỉ đi qua email/console dev.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Venue {
  id             String      @id @default(uuid()) @db.Uuid
  ownerId        String      @db.Uuid
  name           String
  slug           String      @unique
  address        String
  city           String      @default("Hà Nội")
  district       String      @default("Cầu Giấy")
  lat            Float
  lng            Float
  openMinute     Int
  closeMinute    Int
  images         String[]
  amenities      String[]
  depositPercent Int         @default(30)
  status         VenueStatus @default(PENDING)
  rejectReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  owner    User           @relation(fields: [ownerId], references: [id])
  courts   Court[]
  reviews  Review[]
  services VenueService[]

  @@index([status])
  @@index([city, district])
  @@index([lat, lng])
  @@map("venues")
}

model Court {
  id                  String      @id @default(uuid()) @db.Uuid
  venueId             String      @db.Uuid
  name                String
  sportType           SportType
  /// Độ dài slot: chỉ nhận 60 hoặc 90 (validate ở tầng app/zod).
  slotMinutes         Int
  defaultPricePerSlot Int
  status              CourtStatus @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  venue        Venue         @relation(fields: [venueId], references: [id])
  pricingRules PricingRule[]
  bookings     Booking[]
  holds        BookingHold[]

  @@index([venueId])
  @@map("courts")
}

/// Quy tắc giá ghi đè theo khung giờ x loại ngày; trùng đúng khung giờ sẽ bị chặn UNIQUE.
model PricingRule {
  id           String   @id @default(uuid()) @db.Uuid
  courtId      String   @db.Uuid
  dayType      DayType
  startMinute  Int
  endMinute    Int
  pricePerSlot Int
  createdAt    DateTime @default(now())

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, dayType, startMinute, endMinute])
  @@index([courtId])
  @@map("pricing_rules")
}

/// Giữ chỗ tạm 10 phút khi khách bước vào thanh toán; cron mỗi phút chuyển ACTIVE quá hạn -> EXPIRED.
model BookingHold {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  courtId     String            @db.Uuid
  date        DateTime          @db.Date
  startMinute Int
  endMinute   Int
  subtotal    Int
  /// F3 Voucher: snapshot giảm giá NGAY LÚC ÁP MÃ (callback recompute rồi so vnp_Amount,
  /// nên phải đọc giá đã chốt từ hold). null = chưa áp voucher.
  discountAmount Int?
  finalAmount    Int?
  /// Voucher đã áp (audit + consume redemption lúc confirm); không FK để owner xoá mã tự do.
  voucherId      String? @db.Uuid
  expiresAt   DateTime
  status      BookingHoldStatus @default(ACTIVE)
  /// Ghép trận mở (GĐ2): giữ lựa chọn công khai từ lúc hold để copy sang Booking.
  isPublicMatch Boolean?
  slotsNeeded   Int?
  /// S2-F1: đặt sân tư cách đội — giữ teamId từ lúc hold để confirm copy sang Booking.
  teamId      String?           @db.Uuid
  /// P5b O1 (HOLD-FIX): giữ lựa chọn duyệt thành viên từ lúc hold để confirmFromHold
  /// copy sang Booking. NULL/false = join trực tiếp (DIRECT — kèo cũ không phá);
  /// true = POST /bookings/:id/join -> 409 APPROVAL_REQUIRED (qua /matches/:id/requests).
  requiresApproval Boolean?
  /// Dịch vụ đi kèm chọn lúc đặt sân: [{ serviceId, name, quantity, unitPrice }]
  addOns      Json?
  createdAt   DateTime          @default(now())

  user  User  @relation(fields: [userId], references: [id])
  court Court @relation(fields: [courtId], references: [id])
  team  Team? @relation(fields: [teamId], references: [id])

  @@index([courtId, date, status])
  @@index([voucherId])
  @@index([status, expiresAt])
  @@index([teamId])
  @@map("booking_holds")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  /// Mã đơn CH-YYYYMMDD-NNNN, sinh ở tầng app.
  code          String        @unique
  customerId    String?       @db.Uuid
  guestName     String?
  guestPhone    String?
  courtId       String        @db.Uuid
  date          DateTime      @db.Date
  startMinute   Int
  endMinute     Int
  subtotal      Int
  depositAmount Int
  status        BookingStatus @default(CONFIRMED)
  cancelledAt   DateTime?
  cancelReason  String?
  /// Ghép trận mở (GĐ2 & P6): chủ đơn công khai "cần ghép slotsNeeded người".
  isPublicMatch Boolean?
  slotsNeeded   Int?
  matchFull     Boolean?
  matchLevel    MatchLevel? @default(FRIENDLY)
  /// P5a O1: true = join trực tiếp bị chặn (409 APPROVAL_REQUIRED, phải qua /matches/:id/requests).
  /// NULL/false = join trực tiếp như cũ — kèo cũ coi là DIRECT (quyết định chốt 2026-08-30), không phá data cũ.
  requiresApproval Boolean?
  targetPositions String[]
  costPerPerson Int?
  /// P2-B2: mốc chống gửi trùng nhắc lịch (null = chưa nhắc ở mốc đó).
  remindedAt24h DateTime?
  remindedAt2h  DateTime?
  /// F2 Ranking: mốc check-in thực tế (null = chưa check-in; dữ liệu cũ NULL tính trung tính).
  checkedInAt DateTime?
  /// F1 Team Profile: đặt sân tư cách đội (FK teams — Sprint 2).
  teamId      String?   @db.Uuid
  createdAt     DateTime      @default(now())

  customer User?     @relation("BookingCustomer", fields: [customerId], references: [id])
  court    Court     @relation(fields: [courtId], references: [id])
  team         Team?          @relation(fields: [teamId], references: [id])
  payments     Payment[]
  review       Review?
  participants MatchParticipant[]
  addOns       BookingAddOn[]
  expenseShares ExpenseShare[]
  matchJoinRequests MatchJoinRequest[]
  matchComments     MatchComment[]
  fundDrives        FundDrive[]

  @@index([courtId, date])
  @@index([customerId, date])
  @@index([teamId])
  @@map("bookings")
}

/// Ghép trận mở (GĐ2 §3.11): người tham gia đơn ghép trận của chủ đơn.
/// UNIQUE(bookingId, userId) chặn join trùng cả ở mức DB (an toàn với race).
model MatchParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  userId    String   @db.Uuid
  joinedAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
  @@index([bookingId])
  @@map("match_participants")
}

/// Bộ đếm cấp phát mã đơn CH-YYYYMMDD-NNNN theo ngày (hotfix 25P02):
/// INSERT ... ON CONFLICT ("date") DO UPDATE ... RETURNING cấp số ATOMIC
/// ngay trong tx của confirmFromHold -> không bao giờ đụng độ UNIQUE(code).
model BookingCodeSeq {
  date    DateTime @id @db.Date
  lastSeq Int      @default(0)

  @@map("booking_code_seq")
}

/// txnRef UNIQUE = idempotency key cho callback cổng thanh toán.
model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @db.Uuid
  amount    Int
  type      PaymentType
  method    PaymentMethod
  txnRef    String        @unique
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  rawPayload Json?
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("payments")
}

/// Sổ cái ví nội bộ (T0) — NGUỒN SỰ THẬT số dư, append-only: không UPDATE/DELETE,
/// ghi SAU khi commit giao dịch chính (tránh kéo dài FOR UPDATE lock).
/// UNIQUE(refType, refId, type) chặn ghi trùng khi callback retry/crash (hoàn kép).
/// Payment(REFUND) chỉ là chứng từ đối soát; dashboard doanh thu đọc từ bảng này.
model WalletLedger {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @db.Uuid
  direction    WalletLedgerDirection
  type         WalletLedgerType
  /// Số tiền biến động (đồng, luôn dương; chiều do direction quyết định).
  amount       Int
  /// refType: 'TOPUP' | 'BOOKING' ... ; refId: id đối tượng gốc (topup txnRef / bookingId).
  refType      String
  refId        String
  /// Số dư ngay sau biến động (denormalized phục vụ hiển thị lịch sử).
  balanceAfter Int
  createdAt    DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([refType, refId, type])
  @@index([userId, createdAt])
  @@map("wallet_ledgers")
}

/// F3 Voucher — mã giảm giá PERCENT, chỉ áp cho hold nằm trọn cửa sổ giờ thấp điểm.
model Voucher {
  id              String    @id @default(uuid()) @db.Uuid
  /// Mã nhập tại checkout — UNIQUE để tra cứu chính xác một mã.
  code            String    @unique
  percentOff      Int
  /// Cửa sổ khung giờ thấp điểm: hold phải rơi vào dayOfWeek (0=CN..6=7 theo getUTCDay)
  /// và [startMinute, endMinute) nằm trọn trong khoảng phút này.
  dayOfWeek       Int
  validFromMinute Int
  validToMinute   Int
  /// Tổng số lần được dùng; vượt limit chặn bằng UPDATE ... WHERE usedCount < usageLimit (atomic).
  usageLimit      Int
  /// Tối đa mỗi user (v1: UNIQUE(voucherId, userId) siết về 1 — cột giữ cho v2 mở rộng).
  perUserLimit    Int       @default(1)
  usedCount       Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  /// Owner tạo và quản lý voucher cho venue của mình; áp mã phải khớp venue owner.
  ownerId String @db.Uuid
  owner   User   @relation("VoucherOwner", fields: [ownerId], references: [id])

  redemptions VoucherRedemption[]

  @@index([ownerId])
  @@map("vouchers")
}

/// Lần dùng voucher của từng user — UNIQUE(voucherId, userId) chặn dùng lại khi retry/đồng thời.
model VoucherRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  voucherId String   @db.Uuid
  userId    String   @db.Uuid
  /// Hold đã tiêu mã (audit); không FK vì hold có thể bị cron dọn dẹp.
  holdId   String? @db.Uuid
  /// Số tiền được giảm đã snapshot vào hold lúc áp mã.
  amountDiscounted Int
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([voucherId, userId])
  @@index([userId])
  @@map("voucher_redemptions")
}

/// Yêu cầu nạp tiền qua mock gateway (F6). KHÔNG dùng bảng Payment vì Payment.bookingId
/// NOT NULL (topup không gắn booking) — txnRef UNIQUE đóng vai trò idempotency key,
/// callback đối chiếu amount với bản ghi này trước khi ghi ledger.
model WalletTopup {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  /// Số tiền yêu cầu nạp (đồng) — callback phải khớp đúng.
  amount    Int
  method    PaymentMethod @default(MOCK)
  /// Giữ nguyên shape "<id>.TOPUP.<rand>" như Payment.txnRef (riêng namespace TOPUP).
  txnRef    String        @unique
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  rawPayload Json?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("wallet_topups")
}

/// Hàng dư ví mỗi user (F6): cache đồng bộ trong CÙNG transaction với ledger,
/// khoá FOR UPDATE để tính balanceAfter và chặn trừ âm; nguồn sự thật vẫn là wallet_ledgers
/// (lệch số có thể dựng lại bằng SUM ledger theo direction).
model WalletBalance {
  userId    String   @id @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("wallet_balances")
}

/// Đội thể thao (S2-F1): CAPTAIN là người tạo/quản lý; thành viên qua TeamMember.
model Team {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  logoUrl     String?
  description String?
  captainId   String     @db.Uuid
  sportType   SportType
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  captain  User           @relation("TeamCaptain", fields: [captainId], references: [id])
  members  TeamMember[]
  bookings Booking[]
  holds    BookingHold[]
  expenseShares ExpenseShare[]
  fundDrives    FundDrive[]
  fundExpenses  TeamExpense[]
  tournamentEntries TournamentTeam[]
  championOf   Tournament[]      @relation("TournamentChampion")
  matchHome    TournamentMatch[] @relation("MatchHome")
  matchAway    TournamentMatch[] @relation("MatchAway")
  matchWins    TournamentMatch[] @relation("MatchWinner")

  @@index([captainId])
  @@map("teams")
}

/// Thành viên đội (S2-F1): UNIQUE(teamId, userId) chặn join trùng ở mức DB;
/// PENDING khi vừa nhận link mời -> ACTIVE sau khi chấp nhận.
model TeamMember {
  id       String           @id @default(uuid()) @db.Uuid
  teamId   String           @db.Uuid
  userId   String           @db.Uuid
  role     TeamMemberRole   @default(MEMBER)
  status   TeamMemberStatus @default(PENDING)
  joinedAt DateTime         @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// Khoản chia tiền đội (S2-F1) — TRACK-ONLY ghi nợ giữa thành viên:
/// KHÔNG bao giờ trộn vào WalletLedger cá nhân (ô nhiễm ngữ nghĩa balanceAfter).
model ExpenseShare {
  id        String            @id @default(uuid()) @db.Uuid
  teamId    String            @db.Uuid
  /// Đơn đặt sân phát sinh khoản chia (null = khoản ghi nợ thủ công ngoài đặt sân).
  bookingId String?           @db.Uuid
  /// payerId: người đã trả tiền trước; debtorId: người bị ghi nợ.
  payerId   String            @db.Uuid
  debtorId  String            @db.Uuid
  amount    Int
  note      String?
  status    ExpenseShareStatus @default(UNPAID)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  team    Team    @relation(fields: [teamId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  payer   User    @relation("ExpenseSharePayer", fields: [payerId], references: [id])
  debtor  User    @relation("ExpenseShareDebtor", fields: [debtorId], references: [id])

  @@index([teamId, status])
  @@index([debtorId, status])
  /// MAJOR dọn nợ S2: (teamId, bookingId, debtorId) là UNIQUE khi bookingId != null —
  /// enforce bằng PARTIAL UNIQUE INDEX trong migration (Prisma DSL chưa hỗ trợ
  /// partial unique); bookingId null (ghi nợ thủ công) được phép lặp.
  /// App-level vẫn giữ check BOOKING_ALREADY_SPLIT để trả lỗi thân thiện.
  @@index([teamId, bookingId])
  @@map("expense_shares")
}

/// Danh mục dịch vụ đi kèm của cụm sân (S2-F4): nước/bóng/vợt... — owner quản lý menu.
model VenueService {
  id          String           @id @default(uuid()) @db.Uuid
  venueId     String           @db.Uuid
  name        String
  price       Int
  type        VenueServiceType @default(OTHER)
  isAvailable Boolean          @default(true)
  createdAt   DateTime         @default(now())

  venue  Venue         @relation(fields: [venueId], references: [id])
  addOns BookingAddOn[]

  @@index([venueId])
  @@map("venue_services")
}

/// Dịch vụ kèm theo đơn đặt sân (S2-F4): chọn lúc checkout hoặc thêm sau khi CONFIRMED.
/// UNIQUE(bookingId, serviceId): tăng số lượng = UPDATE quantity, không tạo dòng trùng.
model BookingAddOn {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  serviceId String   @db.Uuid
  quantity  Int      @default(1)
  /// Snapshot giá tại lúc thêm (service.price đổi không ảnh hưởng đơn cũ — bài học F3).
  unitPrice Int
  createdAt DateTime @default(now())

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service VenueService @relation(fields: [serviceId], references: [id])

  @@unique([bookingId, serviceId])
  @@index([serviceId])
  @@map("booking_add_ons")
}

/// Mỗi đơn chỉ được đánh giá một lần (bookingId UNIQUE); người đánh giá là khách trong đơn COMPLETED.
model Review {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @db.Uuid
  venueId    String   @db.Uuid
  customerId String   @db.Uuid
  /// 1..5 — validate range ở tầng app (zod).
  rating     Int
  comment    String
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  venue    Venue   @relation(fields: [venueId], references: [id])
  customer User    @relation(fields: [customerId], references: [id])

  @@index([venueId])
  @@map("reviews")
}

/// Thông báo in-app của một người dùng (GĐ2): tạo nội bộ từ các luồng
/// đặt sân/thanh toán/ghép trận; đọc qua GET /notifications.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Đường dẫn phía web (vd /bookings/CH-...) để điều hướng sau khi bấm.
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Trạng thái giải đấu (S3-F7): REGISTRATION -> ONGOING -> FINISHED.
enum TournamentStatus {
  REGISTRATION
  ONGOING
  FINISHED
}

/// Trạng thái một trận trong bracket: PENDING (chưa có đội) -> READY (đủ đội) -> DONE (có kết quả).
enum TournamentMatchStatus {
  PENDING
  READY
  DONE
}

/// Giải đấu loại trực tiếp demo-first (S3-F7): 8 đội tự sinh bracket,
/// v1 KHÔNG gắn booking sân — nhập điểm tay bởi host/admin.
model Tournament {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  sportType      SportType
  maxTeams       Int              @default(8)
  status         TournamentStatus @default(REGISTRATION)
  createdBy      String           @db.Uuid
  /// Đội vô địch được ghi sau trận chung kết (null khi giải chưa xong).
  championTeamId String?          @db.Uuid
  createdAt      DateTime         @default(now())

  creator  User              @relation(fields: [createdBy], references: [id])
  champion Team?             @relation("TournamentChampion", fields: [championTeamId], references: [id])
  teams    TournamentTeam[]
  matches  TournamentMatch[]

  @@index([status])
  @@map("tournaments")
}

/// Lượt đăng ký đội vào giải — UNIQUE(tournamentId, teamId) chặn đăng ký trùng ở mức DB.
model TournamentTeam {
  id           String   @id @default(uuid()) @db.Uuid
  tournamentId String   @db.Uuid
  teamId       String   @db.Uuid
  /// Hạt giống bảng đấu (1 = top seed); null = bốc thăm tự do.
  seed         Int?
  joinedAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@index([teamId])
  @@map("tournament_teams")
}

/// Một trận trong bracket single-elimination — nextMatchId nối cây nhánh.
model TournamentMatch {
  id           String                @id @default(uuid()) @db.Uuid
  tournamentId String                @db.Uuid
  round        Int
  position     Int
  homeTeamId   String?               @db.Uuid
  awayTeamId   String?               @db.Uuid
  homeScore    Int?
  awayScore    Int?
  winnerTeamId String?               @db.Uuid
  /// Trận tiếp theo trong bracket (null = đây là trận chung kết).
  nextMatchId  String?               @db.Uuid
  status       TournamentMatchStatus @default(PENDING)
  createdAt    DateTime              @default(now())

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam   Team?            @relation("MatchHome", fields: [homeTeamId], references: [id])
  awayTeam   Team?            @relation("MatchAway", fields: [awayTeamId], references: [id])
  winner     Team?            @relation("MatchWinner", fields: [winnerTeamId], references: [id])
  nextMatch  TournamentMatch? @relation("BracketNext", fields: [nextMatchId], references: [id])
  feeders    TournamentMatch[] @relation("BracketNext")

  @@unique([tournamentId, round, position])
  @@index([tournamentId, status])
  @@map("tournament_matches")
}

// ---------------------------------------------------------------- P5: Team Treasury

/// Đợt thu quỹ đội (P5): theo tháng hoặc theo trận đặt sân
model FundDrive {
  id          String          @id @default(uuid()) @db.Uuid
  teamId      String          @db.Uuid
  title       String
  description String?
  scope       FundDriveScope  @default(MONTHLY)
  targetAmount Int            // Tổng tiền kỳ vọng thu được
  amountPerMember Int         // Số tiền mỗi thành viên cần đóng
  status      FundDriveStatus @default(ACTIVE)
  bookingId   String?         @db.Uuid
  deadline    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  team          Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  booking       Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  contributions FundContribution[]

  @@index([teamId, status])
  @@map("fund_drives")
}

/// Đóng quỹ của thành viên — trừ trực tiếp qua module ví cá nhân
model FundContribution {
  id          String   @id @default(uuid()) @db.Uuid
  fundDriveId String   @db.Uuid
  userId      String   @db.Uuid
  amount      Int      // Số tiền đã đóng (VND)
  paidAt      DateTime @default(now())
  note        String?

  fundDrive FundDrive @relation(fields: [fundDriveId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fundDriveId])
  @@index([userId])
  @@map("fund_contributions")
}

/// Nhật ký thu - chi quỹ đội kèm ảnh hóa đơn
model TeamExpense {
  id          String            @id @default(uuid()) @db.Uuid
  teamId      String            @db.Uuid
  type        TeamFundEntryType @default(EXPENSE)
  amount      Int               // Số tiền (VND, luôn dương)
  reason      String            // Lý do chi / nguồn thu
  receiptUrl  String?           // Link ảnh hóa đơn/chứng từ
  recordedBy  String            @db.Uuid // Người ghi nhận
  occurredAt  DateTime          @default(now()) // Thời điểm phát sinh thực tế
  createdAt   DateTime          @default(now())

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  recorder User @relation(fields: [recordedBy], references: [id], onDelete: Cascade)

  @@index([teamId, occurredAt])
  @@map("team_expenses")
}

// ---------------------------------------------------------------- P6: Matchmaking Hub

/// Yêu cầu xin tham gia kèo ghép trận (P6)
model MatchJoinRequest {
  id        String                 @id @default(uuid()) @db.Uuid
  bookingId String                 @db.Uuid
  userId    String                 @db.Uuid
  position  String?                // Vị trí sở trường đăng ký chơi
  message   String?                // Lời nhắn cho chủ kèo
  status    MatchJoinRequestStatus @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId])
  @@index([bookingId, status])
  @@map("match_join_requests")
}

/// Bình luận/trao đổi trong kèo ghép trận (P6)
model MatchComment {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("match_comments")
}