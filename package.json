{
  "name": "courthub",
  "version": "0.1.0",
  "private": true,
  "description": "CourtHub — hệ thống đặt và quản lý sân thể thao trực tuyến (đồ án tốt nghiệp)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @courthub/api start:dev",
    "dev:web": "pnpm --filter @courthub/web dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
